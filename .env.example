# ============================================================
# FarmConnect – Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# ============================================================

# ------ Server ------
PORT=5000
NODE_ENV=development

# ------ Firebase Admin SDK (Server-side) ------
# Download from Firebase Console → Project Settings → Service Accounts
# Paste the entire JSON as a single line string, OR provide a file path
FIREBASE_PROJECT_ID=ai-workshop-a4a74
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@ai-workshop-a4a74.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Alternatively, point to a local service account JSON file:
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# ------ Firebase Client SDK (Public – used in frontend) ------
# These are safe to expose in browser JS (protected by Firebase Security Rules)
FIREBASE_API_KEY=AIzaSyA4f-De627muKzyk1NpOsRzcsJU79qM5fc
FIREBASE_AUTH_DOMAIN=ai-workshop-a4a74.firebaseapp.com
FIREBASE_PROJECT_ID_CLIENT=ai-workshop-a4a74
FIREBASE_STORAGE_BUCKET=ai-workshop-a4a74.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=1025144396269
FIREBASE_APP_ID=1:1025144396269:web:1975414f05118b41a5afe4
FIREBASE_MEASUREMENT_ID=G-YHZBVT4W4S

# ------ Legacy MongoDB (optional fallback) ------
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/farmconnect
